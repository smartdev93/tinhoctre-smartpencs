{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(data/**)",
      "Read(docs/**)",
      "Edit(docs/**)",
      "Write(docs/**)",
      "Edit(mkdocs.yml)",
      "Bash(ls:*)",
      "Bash(.venv/bin/mkdocs build:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(python3:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(mkdir -p docs/:*)",
      "Bash(mkdir -p data/pdfs:*)",
      "Bash(mv data/new_pdfs/:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(rm -rf data:*)"
    ]
  }
}
